<Window x:Class="WPF.Hospital.DeletePatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Patient"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Grid.Row="0"
               Content="Delete Patient"
               FontWeight="Bold"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Patients DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgPatients"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="150"/>
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="100"/>
                <DataGridTextColumn Header="Birthdate" Binding="{Binding Birthdate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Delete Button -->
        <Button Grid.Row="2"
                x:Name="btnDeletePatient"
                Content="Delete Selected Patient"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="200"
                Click="btnDeletePatient_Click"/>
    </Grid>
</Window>
