<Window x:Class="WPF.Hospital.UpdatePrescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Prescription"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Label Content="Update Prescription" FontWeight="Bold" FontSize="16"/>
        <DataGrid x:Name="dgPrescriptions"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  Margin="0,40,0,323">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="History ID" Binding="{Binding HistoryId}" Width="100"/>
                <DataGridTextColumn Header="Medicine ID" Binding="{Binding MedicineId}" Width="100"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnUpdatePrescription"
                Content="Update Selected Prescription"
                HorizontalAlignment="Center"
                Width="200"
                Margin="0,323,0,10"
                Click="btnUpdatePrescription_Click"/>
    </Grid>
</Window>
