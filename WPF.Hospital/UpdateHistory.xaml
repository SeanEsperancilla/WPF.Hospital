<Window x:Class="WPF.Hospital.UpdateHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update History"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Label Content="Update History" FontWeight="Bold" FontSize="16"/>
        <DataGrid x:Name="dgHistories"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  Margin="0,40,0,323">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="100"/>
                <DataGridTextColumn Header="Doctor ID" Binding="{Binding DoctorId}" Width="100"/>
                <DataGridTextColumn Header="Diagnosis" Binding="{Binding Diagnosis}" Width="200"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnUpdateHistory"
                Content="Update Selected History"
                HorizontalAlignment="Center"
                Width="200"
                Margin="0,323,0,10"
                Click="btnUpdateHistory_Click"/>
    </Grid>
</Window>
