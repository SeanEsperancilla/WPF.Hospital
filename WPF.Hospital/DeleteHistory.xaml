<Window x:Class="WPF.Hospital.DeleteHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete History"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Grid.Row="0"
               Content="Delete History"
               FontWeight="Bold"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Histories DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgHistories"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="200"/>
                <DataGridTextColumn Header="Doctor" Binding="{Binding DoctorName}" Width="200"/>
                <DataGridTextColumn Header="Procedure" Binding="{Binding Procedure}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Delete Button -->
        <Button Grid.Row="2"
                x:Name="btnDeleteHistory"
                Content="Delete Selected History"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="200"
                Click="btnDeleteHistory_Click"/>
    </Grid>
</Window>
