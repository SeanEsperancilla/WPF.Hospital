<Window x:Class="WPF.Hospital.AllPrescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Prescriptions"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Content="All Prescriptions"
               FontWeight="Bold"
               FontSize="16"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgPrescriptions"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="History ID" Binding="{Binding HistoryId}" Width="100"/>
                <DataGridTextColumn Header="Medicine ID" Binding="{Binding MedicineId}" Width="100"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
