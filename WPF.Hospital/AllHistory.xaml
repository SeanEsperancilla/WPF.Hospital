<Window x:Class="WPF.Hospital.AllHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All History"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Label Content="All Medical Histories"
               FontWeight="Bold"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,10,0,10"/>

        <DataGrid x:Name="dgHistories"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,50,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="200"/>
                <DataGridTextColumn Header="Doctor" Binding="{Binding DoctorName}" Width="200"/>
                <DataGridTextColumn Header="Procedure" Binding="{Binding Procedure}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
