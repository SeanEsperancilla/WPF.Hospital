<Window x:Class="WPF.Hospital.AddPrescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Prescription"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Content="Add Prescription" FontWeight="Bold" FontSize="16"/>

        <!-- Form -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- History Selection -->
            <Label Grid.Row="0" Content="History"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      x:Name="cmbHistory"
                      DisplayMemberPath="Procedure"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding HistoryId}"/>

            <!-- Medicine Selection -->
            <Label Grid.Row="1" Content="Medicine"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      x:Name="cmbMedicine"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding MedicineId}"/>

            <!-- Quantity -->
            <Label Grid.Row="2" Content="Quantity"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="txtQuantity"
                     Text="{Binding Quantity}"/>

            <!-- Frequency -->
            <Label Grid.Row="3" Content="Frequency"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     x:Name="txtFrequency"
                     Text="{Binding Frequency}"/>
        </Grid>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Content="Add Prescription"
                x:Name="btnAddPrescription"
                Click="btnAddPrescription_Click"
                HorizontalAlignment="Center"
                Width="150" Height="50" VerticalAlignment="Top"/>
    </Grid>
</Window>
