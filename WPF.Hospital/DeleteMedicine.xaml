<Window x:Class="WPF.Hospital.DeleteMedicine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Medicine"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="Delete Medicine"
               FontWeight="Bold"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <DataGrid Grid.Row="1"
                  x:Name="dgMedicines"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                x:Name="btnDeleteMedicine"
                Content="Delete Selected Medicine"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="200"
                Click="btnDeleteMedicine_Click"/>
    </Grid>
</Window>
