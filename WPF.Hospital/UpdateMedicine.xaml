<Window x:Class="WPF.Hospital.UpdateMedicine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Medicine"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Grid.Row="0"
               Content="Update Medicine"
               FontWeight="Bold"
               FontSize="16"/>

        <!-- Medicines DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="dgMedicines"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Update Button -->
        <Button Grid.Row="2"
                x:Name="btnUpdateMedicine"
                Content="Update Selected Medicine"
                HorizontalAlignment="Center"
                Width="200"
                Click="btnUpdateMedicine_Click"/>
    </Grid>
</Window>
